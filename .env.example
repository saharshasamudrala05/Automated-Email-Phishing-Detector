# ═══════════════════════════════════════════════════════
#  AI PHISHING ANALYZER — ENVIRONMENT CONFIGURATION
#  1. Copy this file:   cp .env.example .env
#  2. Fill in your API key(s) below
#  3. Never commit the .env file to git
# ═══════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────
# CHOOSE YOUR AI PROVIDER
# Options: groq | gemini
# ───────────────────────────────────────────────────────
AI_PROVIDER=groq

# ───────────────────────────────────────────────────────
# GROQ API KEY (Recommended — fastest free tier)
# Sign up FREE at: https://console.groq.com
# No credit card required. Generous rate limits.
# ───────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ───────────────────────────────────────────────────────
# GOOGLE GEMINI API KEY (Alternative free option)
# Get free key at: https://aistudio.google.com/app/apikey
# No credit card required for free tier.
# ───────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
